#!/usr/bin/php
<?php
/*
 * console
 *
 * Тонкий бутстрап консоли Quark: env + APP + dispatch.
 * Вся механика — в фасаде console (engine/facades/console.php):
 *
 * 	./console a b c ...
 * 	│
 * 	├─ 1. Команда-файл: самый длинный существующий префикс
 * 	│     engine/console/**.php → include в скоупе фасада.
 * 	│     Команда видит $this->args/flags/vars и $APP.
 * 	│
 * 	├─ 2. Фасад-фолбэк: $APP->{a} + метод {b} → вызов с хвостом.
 * 	│
 * 	└─ 3. Ничего не нашлось → команда help.
 *
 * Провал = только выброшенное исключение → stderr + exit≠0.
 *
 */

error_reporting(E_ALL & ~E_NOTICE);

# ---------------------------------------------------------------- #
#               Инициализация переменных окружения                 #
# ---------------------------------------------------------------- #
$_ENV = array_merge(parse_ini_file(".env", true), $_ENV);


# ---------------------------------------------------------------- #
#             Объявление автозагрузки (стандарт PSR4)              #
# ---------------------------------------------------------------- #
include_once $_ENV['core']['path']."core.php";


# ---------------------------------------------------------------- #
#                     Инициализация приложения                     #
# ---------------------------------------------------------------- #
$APP = new APP($_ENV['core']['path'], $_ENV['facades'], $_ENV['vendor']);
$APP->config->loadENV(['.env', 'app/.env']);


//Автоустановка автодополнения при первом запуске: маркер — файл
//в ленивом каталоге bash-completion; подхватится в новых сессиях.
//Не удалось записать — молча пропускаем. Разовая проверка — один stat().
if (($_ENV['console']['completion'] ?? 1) and stripos(PHP_OS, 'WIN') !== 0
	and ($home = getenv('HOME'))
	and !is_file("$home/.local/share/bash-completion/completions/console"))
{
	try {
			$APP->console->dispatch(['completion', 'install']);
		}
	catch (Throwable $ignore) {}
}


try
{
	$APP->console->dispatch(array_slice((array)$argv, 1));
}
catch (Throwable $e)
{
echo "
　　　　　　／＞　 フ
　　　　　 /　_　 _|
　 　　　／`ミ _x 彡
　　 　 /　　　 　/
　　　 /　 ヽ　　 ﾉ
　／￣|　　 |　| |
 | (￣ヽ_＿_ヽ_)_)
　＼二つ
";
	fwrite(STDERR, $e->getMessage()."\n");
	exit(($code = $e->getCode()) ? $code : 12);
}
