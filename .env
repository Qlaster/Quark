[core]
path   = "engine/core/"

[vendor]
;статические пакеты фреймворка
engine   = "engine/vendor"
;composer (появится с composer install)
composer = "vendor"

[facades]
app    = "engine/facades"
models = "app/models"

[console]
path       = "engine/console"
;Автоустановка bash-дополнения в ~/.local/share/bash-completion (0 — выкл)
completion = 1

[mode]
;Имя режима; пусто — сайт живой. Карта: <имя>.controller — файл заглушки
name                   = ""
maintenance.controller = "app/controllers/error/maintenance.php"
maintenance.eta        = 120
